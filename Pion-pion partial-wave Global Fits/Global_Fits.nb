    RowBox[{"(", 
     RowBox[{"B122", "+", 
      RowBox[{"2", " ", "B222", " ", 
       RowBox[{"v22", "[", "sm22", "]"}]}]}], ")"}], 
    FractionBox["s022", "sh22"], " ", 
    FractionBox[
     SqrtBox[
      RowBox[{"sh22", "-", "sm22"}]], 
     SqrtBox[
      RowBox[{"s022", "-", "sm22"}]]], 
