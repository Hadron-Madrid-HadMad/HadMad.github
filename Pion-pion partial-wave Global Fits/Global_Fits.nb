}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Amplitude",
 FontColor->RGBColor[1, 0.5, 0]]], "Subsubsection",
 CellChangeTimes->{{4.001132329321929*^9, 4.001132341138143*^9}, 
   4.0011325674821873`*^9, {4.001132930763809*^9, 4.001132937099854*^9}, 
   4.0011468548747177`*^9},ExpressionUUID->"449c318f-1b2a-4a45-a4df-\
0fa44967d107"],

Cell[TextData[StyleBox["First, the Breit-Wigner amplitude, valid above 1.2 \
GeV",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 
   4.001150508839294*^9}},ExpressionUUID->"fc74eaf1-48fa-4311-82ab-\
208832eb5561"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"q13", "=", 
   RowBox[{"kp", "[", 
    SuperscriptBox["m\[Rho]3", "2"], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]13", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s013", "=", 
   SuperscriptBox["1.5", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sm13", "=", 
   SuperscriptBox["1.2", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s\[Eta]13", "=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"Mp", "+", "M\[Omega]"}], ")"}], "2"]}], ";"}]}], "Input",
 CellChangeTimes->{{3.922791796597876*^9, 3.9227917998529053`*^9}, 
   4.0011501644696302`*^9},
 CellLabel->
  "In[196]:=",ExpressionUUID->"d4b9baca-7160-498a-85a8-f2347a925227"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"w13", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{
     SqrtBox["s"], "-", 
     RowBox[{"\[Alpha]13", " ", 
      SqrtBox[
       RowBox[{"s013", "-", "s"}]]}]}], 
    RowBox[{
     SqrtBox["s"], "+", 
     RowBox[{"\[Alpha]13", " ", 
      SqrtBox[
       RowBox[{"s013", "-", "s"}]]}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v13", "[", "s_", "]"}], "=", 
   RowBox[{"w13", "[", 
    RowBox[{"s", "+", " ", 
     RowBox[{
      SuperscriptBox["10", 
       RowBox[{"-", "18"}]], " ", "I"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Blatt3", "[", "s_", "]"}], "=", 
   RowBox[{
    SuperscriptBox["s", "6"], "+", 
    RowBox[{"6", " ", 
     SuperscriptBox["s", "4"]}], "+", 
    RowBox[{"45", " ", 
     SuperscriptBox["s", "2"]}], "+", "225"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9227918021707697`*^9, 3.9227918051695013`*^9}},
 CellLabel->
  "In[201]:=",ExpressionUUID->"a195408e-a460-4851-abe5-18ae1621b3da"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]13", "[", "s_", "]"}], "=", 
   RowBox[{"\[CapitalGamma]\[Rho]3", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"kp", "[", "s", "]"}], "q13"], ")"}], "7"], " ", 
    FractionBox[
     RowBox[{"Blatt3", "[", 
      RowBox[{"q13", " ", "R\[Rho]3"}], "]"}], 
     RowBox[{"Blatt3", "[", 
      RowBox[{
       RowBox[{"kp", "[", "s", "]"}], " ", "R\[Rho]3"}], "]"}]]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9227918061314087`*^9, 3.922791807870243*^9}},
 CellLabel->
  "In[204]:=",ExpressionUUID->"913ff936-382f-4c69-92c2-292027a46223"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tbw13", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{"x\[Rho]3", " ", "m\[Rho]3", " ", 
     RowBox[{"\[CapitalGamma]13", "[", "s", "]"}]}], 
    RowBox[{
     RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["m\[Rho]3", "2"], "-", "s", "-", 
       RowBox[{"I", " ", "m\[Rho]3", " ", 
        RowBox[{"\[CapitalGamma]13", "[", "s", "]"}]}]}], ")"}]}]]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.922791808942932*^9, 3.9227918105705223`*^9}},
 CellLabel->
  "In[205]:=",ExpressionUUID->"9422519a-0a68-4bb6-957e-1de6c07de7ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Sbw13", "[", "s_", "]"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"2", " ", "I", " ", 
     RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
     RowBox[{"tbw13", "[", "s", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791811275276*^9, 3.922791812092244*^9}},
 CellLabel->
  "In[206]:=",ExpressionUUID->"544a93ce-3967-4b99-9b87-b1b6a0ab37c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]bw13", "[", "s_", "]"}], "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"ArcTan", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Sbw13", "[", "s", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"Sbw13", "[", "s", "]"}], "]"}]}], "]"}], " ", 
     FractionBox["90", "\[Pi]"]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227918128798933`*^9, 3.922791814739327*^9}},
 CellLabel->
  "In[207]:=",ExpressionUUID->"1e331811-9c9e-48d8-99c9-9c08e4a49bd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]bw13", "[", "s_", "]"}], "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"Sbw13", "[", "s", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9227826612675037`*^9, {3.922791815632805*^9, 3.922791816907771*^9}},
 CellLabel->
  "In[208]:=",ExpressionUUID->"8338d7e8-d844-4098-a881-ab5733df3771"],

Cell[TextData[StyleBox["Now, let\[CloseCurlyQuote]s define the low-energy \
conformal amplitude, matched to the B-W amplitude at 1.2 GeV",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 
   4.001150535608149*^9}},ExpressionUUID->"d4afce8b-2b7f-4b5a-9982-\
9dd9e457ec8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fac13", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     SqrtBox["s"], 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"kp", "[", "s", "]"}], "7"]}]], 
    SuperscriptBox["Mp", "6"]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.922791817792634*^9, {4.001150214752404*^9, 4.001150217462391*^9}},
 CellLabel->
  "In[209]:=",ExpressionUUID->"82362098-6508-47df-b8f8-02c2e330bb3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cotbweff13", "[", "s_", "]"}], "=", 
   FractionBox["1", 
    RowBox[{
     RowBox[{"Tan", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Delta]bw13", "[", "s", "]"}], " ", "\[Pi]"}], "180"], 
      "]"}], " ", 
     RowBox[{"fac13", "[", "s", "]"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791818767715*^9, 3.9227918202221937`*^9}},
 CellLabel->
  "In[210]:=",ExpressionUUID->"3e488ee9-f3db-45c1-a463-cd2bef8b1c06"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"derc13", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"cotbweff13", "[", 
      RowBox[{"sm13", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"cotbweff13", "[", 
      RowBox[{"sm13", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derv13", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"v13", "[", 
      RowBox[{"sm13", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"v13", "[", 
      RowBox[{"sm13", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.922782677524312*^9, {3.9227918210483227`*^9, 3.9227918267860928`*^9}},
 CellLabel->
  "In[211]:=",ExpressionUUID->"863f660d-2921-4647-9b33-c6f1580759d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"b113", "=", 
   RowBox[{
    FractionBox["derc13", "derv13"], "-", 
    RowBox[{"2", " ", "b213", " ", 
     RowBox[{"v13", "[", "sm13", "]"}]}], "-", 
    RowBox[{"3", " ", "b313", " ", 
     SuperscriptBox[
      RowBox[{"v13", "[", "sm13", "]"}], "2"]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b013", "=", 
   RowBox[{
    RowBox[{"cotbweff13", "[", "sm13", "]"}], "-", 
    RowBox[{"b113", " ", 
     RowBox[{"v13", "[", "sm13", "]"}]}], "-", 
    RowBox[{"b213", " ", 
     SuperscriptBox[
      RowBox[{"v13", "[", "sm13", "]"}], "2"]}], "-", 
    RowBox[{"b313", " ", 
     SuperscriptBox[
      RowBox[{"v13", "[", "sm13", "]"}], "3"]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.922791827107851*^9, 3.922791833168687*^9}},
 CellLabel->
  "In[213]:=",ExpressionUUID->"a9424356-bb67-45b1-bbad-38ceb4bef98e"],

Cell[TextData[StyleBox["The conformal phase-shift is defined as",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 4.001150535608149*^9}, {
   4.001150903799925*^9, 
   4.0011509107399073`*^9}},ExpressionUUID->"4d7e63ea-b967-4b94-a0ec-\
173532c75a36"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cot\[Delta]low13", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"b013", "+", 
      RowBox[{"b113", " ", 
       RowBox[{"v13", "[", "s", "]"}]}], "+", 
      RowBox[{"b213", " ", 
       SuperscriptBox[
        RowBox[{"v13", "[", "s", "]"}], "2"]}], "+", 
      RowBox[{"b313", " ", 
       SuperscriptBox[
        RowBox[{"v13", "[", "s", "]"}], "3"]}]}], 
     RowBox[{
      RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
      SuperscriptBox[
       RowBox[{"kp", "[", "s", "]"}], "6"]}]], 
    SuperscriptBox["Mp", "6"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791833386941*^9, 3.922791834595387*^9}, 
   4.001150249499166*^9},
 CellLabel->
  "In[215]:=",ExpressionUUID->"cb6ee32c-8b67-4c80-a74b-42caa3e9fbae"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]low13", "[", "s_", "]"}], "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"ArcCot", "[", 
      RowBox[{"cot\[Delta]low13", "[", "s", "]"}], "]"}], " ", 
     FractionBox["180", "\[Pi]"]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227918347512913`*^9, 3.922791834930093*^9}},
 CellLabel->
  "In[216]:=",ExpressionUUID->"19a26f28-361c-43e2-aac0-81a8d09b8a1d"],

Cell[TextData[StyleBox["The phase-shift in the whole range is",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 4.001150535608149*^9}, 
   4.0011508491898327`*^9},ExpressionUUID->"527bf8d3-8a54-4986-9946-\
b6122d0d668d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]13", "[", "s_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]low13", "[", "s", "]"}], ",", 
        RowBox[{"s", "<=", "sm13"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]bw13", "[", "s", "]"}], ",", 
        RowBox[{"s", ">", "sm13"}]}], "}"}]}], "}"}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.922782695822508*^9, 3.922782717922214*^9}, {
   3.922791835134202*^9, 3.922791835876635*^9}, 3.923231547026719*^9},
 CellLabel->
  "In[217]:=",ExpressionUUID->"2e8b0dd1-29a1-46a2-b765-046349f3bf31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]13", "=", 
   FractionBox[
    RowBox[{"1", "-", 
     RowBox[{"\[Eta]bw13", "[", "sm13", "]"}]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["s\[Eta]13", "sm13"]}], ")"}], 
     RowBox[{"7", "/", "2"}]]]}], ";"}]], "Input",
 CellChangeTimes->{
  3.922782725445541*^9, {3.922791836056244*^9, 3.922791836872155*^9}},
 CellLabel->
  "In[218]:=",ExpressionUUID->"4391cdb8-4b70-4f43-95f7-5c56b2ac7e19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"der\[Eta]13", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Eta]bw13", "[", 
      RowBox[{"sm13", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"\[Eta]bw13", "[", 
      RowBox[{"sm13", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791837060272*^9, 3.9227918378698797`*^9}},
 CellLabel->
  "In[219]:=",ExpressionUUID->"741955af-ff33-4ea3-b51b-4d5b0f4ad86f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r13", "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"sm13", " ", "der\[Eta]13"}], 
       RowBox[{"1", "-", 
        RowBox[{"\[Eta]bw13", "[", "sm13", "]"}]}]], "+", 
      FractionBox[
       RowBox[{"7", " ", "s\[Eta]13"}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"sm13", "-", "s\[Eta]13"}], ")"}]}]]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.922791838059348*^9, 3.9227918394999323`*^9}},
 CellLabel->
  "In[220]:=",ExpressionUUID->"3c6d3aac-babb-4c89-9871-8eb6dbd680c2"],

Cell[TextData[StyleBox["The elasticity in the whole range is",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 4.001150535608149*^9}, 
   4.001150855614368*^9},ExpressionUUID->"2482e12c-6ea7-4980-ae6d-\
165b75baa4a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]13", "[", "s_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"s", "<=", "s\[Eta]13"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"Re", "[", "\[Epsilon]13", "]"}], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox["s\[Eta]13", "s"]}], ")"}], 
           RowBox[{"7", "/", "2"}]], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"Re", "[", "r13", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               FractionBox["sm13", "s"]}], ")"}]}]}], ")"}]}]}], ",", 
        RowBox[{"s\[Eta]13", "<", "s", "<=", "sm13"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"\[Eta]bw13", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"s", ">", "sm13"}]}], "}"}]}], "}"}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{
  3.922782815760425*^9, {3.922791839709784*^9, 3.9227918439243107`*^9}, {
   3.9232884703202477`*^9, 3.92328847418441*^9}},
 CellLabel->
  "In[221]:=",ExpressionUUID->"81148e0b-9eaa-4273-acde-4ab27b0f232f"],

Cell[TextData[StyleBox["This is the final F Global Fit parametrization",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 4.001150535608149*^9}, 
   4.001150864191135*^9},ExpressionUUID->"f199e6ba-e563-4640-bf40-\
e44578f8a7c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t13", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]13", "[", "s", "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"\[Delta]13", "[", "s", "]"}], " ", 
