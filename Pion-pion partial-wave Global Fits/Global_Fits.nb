Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]high11", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Delta]low11", "[", "sm211", "]"}], "+", " ", 
    RowBox[{"\[CapitalDelta]11", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"chev1", "[", 
