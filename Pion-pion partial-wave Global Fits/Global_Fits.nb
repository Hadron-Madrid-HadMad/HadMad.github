    FractionBox[
     SuperscriptBox["s", 
      RowBox[{"1", "/", "2"}]], 
     RowBox[{"2", " ", 
      RowBox[{"kp", "[", "s", "]"}]}]], 
    FractionBox[
     SuperscriptBox["Mp", "2"], 
     RowBox[{"s", "-", 
      RowBox[{"2", 
       SuperscriptBox["z20", "2"]}]}]], 
    RowBox[{"(", 
