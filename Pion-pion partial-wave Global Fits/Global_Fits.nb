  RowBox[{
   RowBox[{"t24", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"2", "\[ImaginaryI]", " ", 
        RowBox[{"\[Delta]24", "[", "s", "]"}], "*", 
        RowBox[{"\[Pi]", "/", "180"}]}], "]"}], "-", "1"}], ")"}], 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"\[Sigma]pp", "[", "s", "]"}]}]]}], ";"}]], "Input",
