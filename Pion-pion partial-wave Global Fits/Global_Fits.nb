0f3695dea7c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]04", "[", "s_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"s", "<=", "s\[Eta]04"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"Re", "[", "\[Epsilon]04", "]"}], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox["s\[Eta]04", "s"]}], ")"}], 
           RowBox[{"9", "/", "2"}]], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"Re", "[", "r04", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               FractionBox["sm04", "s"]}], ")"}]}]}], ")"}]}]}], ",", 
        RowBox[{"s\[Eta]04", "<", "s", "<=", "sm04"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"\[Eta]bw04", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"s", ">", "sm04"}]}], "}"}]}], "}"}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{
