        SuperscriptBox["s", 
         RowBox[{"1", "/", "2"}]]}]], "+", "B000", "+", 
      RowBox[{"B100", " ", 
       RowBox[{"v00", "[", "s", "]"}]}], "+", 
      RowBox[{"B200", " ", 
       SuperscriptBox[
        RowBox[{"v00", "[", "s", "]"}], "2"]}], "+", 
      RowBox[{"B300", " ", 
       SuperscriptBox[
        RowBox[{"v00", "[", "s", "]"}], "3"]}], "+", 
      RowBox[{"B400", " ", 
       SuperscriptBox[
        RowBox[{"v00", "[", "s", "]"}], "4"]}], "+", 
      RowBox[{"B500", " ", 
       SuperscriptBox[
        RowBox[{"v00", "[", "s", "]"}], "5"]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.922760165465465*^9, {4.0011305156458406`*^9, 4.001130519994954*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"ce138d5c-6cc4-4256-b51e-1947746d7ffa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t00conf", "[", "s_", "]"}], "=", 
   FractionBox["1", 
    RowBox[{
     RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"cot\[Delta]00conf", "[", "s", "]"}], "-", " ", "I"}], 
      ")"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{3.922760177881291*^9},
 CellLabel->"In[28]:=",ExpressionUUID->"48cd31c0-4c1b-4e75-956a-dcc26ee067a7"],

Cell[TextData[StyleBox["Now, we implement the f0(980) amplitude",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 
  4.001132646343431*^9}},ExpressionUUID->"e7e10ae9-3218-44ff-9046-\
c6ecd03e5537"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Jp00", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox["2", "Pi"], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Sigma]pp", "[", "s", "]"}], "Pi"], "*", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Sigma]pp", "[", "s", "]"}], "-", "1"}], 
       RowBox[{
        RowBox[{"\[Sigma]pp", "[", "s", "]"}], "+", "1"}]], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Jk00", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox["2", "Pi"], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Sigma]kk", "[", "s", "]"}], "Pi"], "*", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Sigma]kk", "[", "s", "]"}], "-", "1"}], 
       RowBox[{
        RowBox[{"\[Sigma]kk", "[", "s", "]"}], "+", "1"}]], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vchev00", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"2", " ", 
     FractionBox[
      RowBox[{
       SuperscriptBox["s", 
        RowBox[{"1", "/", "2"}]], "-", 
       RowBox[{"2", " ", "Mk"}]}], 
      RowBox[{"1.5", "-", 
       RowBox[{"2", " ", "Mk"}]}]]}], "-", "1"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9227601872172117`*^9},
 CellLabel->"In[29]:=",ExpressionUUID->"cfd28066-7434-49d9-b0ca-c527b4839cb2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f00", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"Mk", "^", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{"k000", "+", 
      RowBox[{"k100", " ", 
       RowBox[{"chev1", "[", 
        RowBox[{"vchev00", "[", "s", "]"}], "]"}]}], "+", 
      RowBox[{"k200", " ", 
       RowBox[{"chev2", "[", 
        RowBox[{"vchev00", "[", "s", "]"}], "]"}]}], "+", 
      RowBox[{"k300", " ", 
       RowBox[{"chev3", "[", 
        RowBox[{"vchev00", "[", "s", "]"}], "]"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fr", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"f00", "[", "sp00", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fi", "=", 
   RowBox[{"Im", "[", 
    RowBox[{"f00", "[", "sp00", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jkr", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"Jk00", "[", "sp00", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jki", "=", 
   RowBox[{"Im", "[", 
    RowBox[{"Jk00", "[", "sp00", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jpr", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"Jp00", "[", "sp00", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jpi", "=", 
   RowBox[{"Im", "[", 
    RowBox[{"Jp00", "[", "sp00", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigmar", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"\[Sigma]pp", "[", "sp00", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigmai", "=", 
   RowBox[{"Im", "[", 
    RowBox[{"\[Sigma]pp", "[", "sp00", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sr", "=", 
   RowBox[{"Re", "[", "sp00", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"si", "=", 
   RowBox[{"Im", "[", "sp00", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d", "=", 
   RowBox[{
    RowBox[{"Jpi", " ", "sr"}], "+", 
    RowBox[{"Jpr", " ", "si"}], "+", 
    RowBox[{"2", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"sigmai", " ", "si"}], "-", 
       RowBox[{"sigmar", " ", "sr"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{"fi", " ", "Jkr"}], "+", 
      RowBox[{"fr", " ", "Jki"}], "+", "si"}], "d"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"fi", " ", "Jkr"}], "+", 
         RowBox[{"fr", " ", "Jki"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"si", "*", 
          RowBox[{"(", 
           RowBox[{"Jpi", "-", 
            RowBox[{"2", " ", "sigmar"}]}], ")"}]}], "-", 
         RowBox[{"sr", "*", 
          RowBox[{"(", 
           RowBox[{"Jpr", "+", 
            RowBox[{"2", " ", "sigmai"}]}], ")"}]}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Jpi", "-", 
         RowBox[{"2", " ", "sigmar"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"si", "^", "2"}], "+", 
         RowBox[{"sr", "^", "2"}]}], ")"}]}]}], "d"], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"fi", " ", "Jki"}], "-", 
      RowBox[{"fr", " ", "Jkr"}]}], ")"}]}]}], ";"}]}], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"3b114798-b611-4c20-a358-432b5f6f2684"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t00f", "[", "s_", "]"}], ":=", 
   FractionBox[
    RowBox[{"s", "*", "G"}], 
    RowBox[{"M", "-", "s", "-", 
     RowBox[{
      RowBox[{"Jp00", "[", "s", "]"}], "*", "s", "*", "G"}], "-", 
     RowBox[{
      RowBox[{"Jk00", "[", "s", "]"}], "*", 
      RowBox[{"f00", "[", "s", "]"}]}]}]]}], ";"}]], "Input",
 CellChangeTimes->{3.922760198040762*^9},
 CellLabel->"In[46]:=",ExpressionUUID->"95746272-cf6a-45a0-8163-d55cf6b1cd8f"],

