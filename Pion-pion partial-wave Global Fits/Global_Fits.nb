Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]111", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"-", "der\[Eta]11"}], 
     RowBox[{"2", " ", "\[Epsilon]011", " ", 
      RowBox[{"\[Eta]low11", "[", "sm211", "]"}], " ", "derv11"}]], "+", 
    RowBox[{"4", " ", "\[Epsilon]211"}], "-", 
    RowBox[{"9", "\[Epsilon]311"}], "+", 
    RowBox[{"16", " ", "\[Epsilon]411"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922781046005394*^9, 3.92278106235785*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"5b72dbae-8bf7-4b7c-94af-6b142ceb5080"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]high11", "[", "s_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[Epsilon]011", "+", 
        RowBox[{"\[Epsilon]111", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"chev1", "[", 
            RowBox[{"vchev211", "[", "s", "]"}], "]"}], "+", "1"}], ")"}]}], 
        "+", 
        RowBox[{"\[Epsilon]211", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"chev2", "[", 
            RowBox[{"vchev211", "[", "s", "]"}], "]"}], "-", "1"}], ")"}]}], 
        "+", 
        RowBox[{"\[Epsilon]311", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"chev3", "[", 
            RowBox[{"vchev211", "[", "s", "]"}], "]"}], "+", "1"}], ")"}]}], 
        "+", 
        RowBox[{"\[Epsilon]411", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"chev4", "[", 
            RowBox[{"vchev211", "[", "s", "]"}], "]"}], "-", "1"}], ")"}]}]}],
        ")"}], "2"]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922781071502269*^9, 3.922781081838969*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"e74b6f59-f00c-4df8-b7f4-fa378657f838"],

Cell["\<\
This is the final P Global Fit parametrization, and the corresponding \
phase-shift and elasticity functions\
\>", "Text",
 CellChangeTimes->{{4.0011328152899723`*^9, 4.0011328216574697`*^9}, {
  4.0011371627399263`*^9, 4.0011371723877583`*^9}},
 FontColor->RGBColor[
  1, 0, 0],ExpressionUUID->"9a6db44f-2038-4cf6-9bda-09b788b354f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]11", "[", "s_", "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]low11", "[", "s", "]"}], ",", 
        RowBox[{"s", "<=", "sm211"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]high11", "[", "s", "]"}], ",", 
        RowBox[{"s", ">", "sm211"}]}], "}"}]}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.922780792240443*^9, 3.922780819280751*^9}, {
   3.922781021285728*^9, 3.9227810226053534`*^9}, 3.923288324472413*^9},
 CellLabel->
  "In[105]:=",ExpressionUUID->"9319a324-282a-48bf-af9e-f8c5d7c3811c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]11", "[", "s_", "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Eta]low11", "[", "s", "]"}], ",", 
        RowBox[{"s", "<=", "sm211"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Eta]high11", "[", "s", "]"}], ",", 
        RowBox[{"s", ">", "sm211"}]}], "}"}]}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.92278120960855*^9, 3.923288331985229*^9},
 CellLabel->
  "In[106]:=",ExpressionUUID->"98779db7-d0d7-4b7d-b7ae-3a3a60b53db9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t11", "[", "s_", "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]11", "[", "s", "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"\[Delta]11", "[", "s", "]"}], " ", 
         RowBox[{"\[Pi]", "/", "90"}]}], "]"}]}], "-", "1"}], ")"}], 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"\[Sigma]pp", "[", "s", "]"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.922781213377213*^9, 3.922781222242082*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"0be35b81-1a8a-4dba-9407-bc2aecaec27a"]
}, Closed]],

