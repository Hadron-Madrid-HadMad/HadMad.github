 CellLabel->"In[96]:=",ExpressionUUID->"8fce9c2e-f6f8-417c-b32f-20307cc1efe1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"der\[Delta]11", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Delta]low11", "[", 
      RowBox[{"sm211", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"\[Delta]low11", "[", 
      RowBox[{"sm211", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}]], "Input",
