      RowBox[{"R\[Rho]3", "->", "4.92"}], ",", 
      RowBox[{"x\[Rho]3", "->", "0.284"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]Fpar2", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[CapitalDelta]b213", "->", 
       RowBox[{"1.6", "*", 
        RowBox[{"10", "^", "3"}]}]}], ",", 
      RowBox[{"\[CapitalDelta]b313", "->", 
       RowBox[{"8", "*", 
        RowBox[{"10", "^", "3"}]}]}], ",", 
      RowBox[{"\[CapitalDelta]\[CapitalGamma]\[Rho]3", "->", "0.007"}], ",", 
      RowBox[{"\[CapitalDelta]m\[Rho]3", "->", "0.002"}], ",", 
      RowBox[{"\[CapitalDelta]R\[Rho]3", "->", "0.02"}], ",", 
      RowBox[{"\[CapitalDelta]x\[Rho]3", "->", "0.009"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Fpar3", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"b213", "->", 
       RowBox[{"129.0", "*", 
        RowBox[{"10", "^", "3"}]}]}], ",", 
      RowBox[{"b313", "->", 
       RowBox[{"10", "*", 
        RowBox[{"10", "^", "3"}]}]}], ",", 
      RowBox[{"\[CapitalGamma]\[Rho]3", "->", "0.242"}], ",", 
      RowBox[{"m\[Rho]3", "->", "1.719"}], ",", 
      RowBox[{"R\[Rho]3", "->", "5.86"}], ",", 
      RowBox[{"x\[Rho]3", "->", "0.235"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalDelta]Fpar3", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalDelta]b213", "->", 
      RowBox[{"1.6", "*", 
       RowBox[{"10", "^", "3"}]}]}], ",", 
     RowBox[{"\[CapitalDelta]b313", "->", 
      RowBox[{"8", "*", 
       RowBox[{"10", "^", "3"}]}]}], ",", 
