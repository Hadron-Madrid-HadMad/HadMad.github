Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]high00", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Delta]low00", "[", "sm00", "]"}], "+", " ", 
    RowBox[{"\[CapitalDelta]00", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"chev1", "[", 
        RowBox[{"vchev200", "[", "s", "]"}], "]"}], "+", "1"}], ")"}]}], "+", 
