Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Epsilon]011", "=", 
    SqrtBox[
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{"\[Eta]low11", "[", "sm211", "]"}], "]"}]}]]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Caution", ",", 
    RowBox[{
    "this", " ", "eps0", " ", "is", " ", "different", " ", "from", " ", "the",
