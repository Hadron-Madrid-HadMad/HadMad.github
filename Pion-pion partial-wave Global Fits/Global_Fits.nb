     RowBox[{"s", "+", " ", 
      RowBox[{"I", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "18"}]]}]}], ",", "sh02"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.9227813346296997`*^9, {3.922791666740176*^9, 3.9227916685170097`*^9}},
