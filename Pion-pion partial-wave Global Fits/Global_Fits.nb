 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]02conf1", "[", "s_", "]"}], "=", 
   RowBox[{"ArcCot", "[", 
    RowBox[{"cot\[Delta]02conf1", "[", "s", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.922781344534864*^9, {3.9227916730544777`*^9, 3.922791673526278*^9}},
 CellLabel->
  "In[146]:=",ExpressionUUID->"2e687288-ad66-4142-ba20-2bcf4bab5d79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Bh102", "=", 
   RowBox[{
    RowBox[{"B102", " ", 
     FractionBox["s002", "sh02"], " ", 
     FractionBox[
      SqrtBox[
       RowBox[{"sh02", "-", "sm02"}]], 
      SqrtBox[
       RowBox[{"s002", "-", "sm02"}]]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         SqrtBox["sm02"], "+", 
         SqrtBox[
          RowBox[{"sh02", "-", "sm02"}]]}], 
        RowBox[{
         SqrtBox["sm02"], "+", 
         SqrtBox[
          RowBox[{"s002", "-", "sm02"}]]}]], ")"}], "2"]}], " ", "-", " ", 
    RowBox[{"2", " ", "Bh202", " ", 
     RowBox[{"vh02", "[", "sm02", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Bh002", "=", 
   RowBox[{"B002", "+", 
    RowBox[{"B102", " ", 
     RowBox[{"v02", "[", "sm02", "]"}]}], "-", 
    RowBox[{"Bh102", " ", 
     RowBox[{"vh02", "[", "sm02", "]"}]}], "-", 
    RowBox[{"Bh202", " ", 
     SuperscriptBox[
      RowBox[{"vh02", "[", "sm02", "]"}], "2"]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.922791674008136*^9, 3.922791685399777*^9}},
