  "In[126]:=",ExpressionUUID->"178a4154-96d4-417d-9151-ca2172332492"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]20", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Delta]20conf1", "[", "s", "]"}], ",", 
         RowBox[{"s", "<=", "sm20"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Delta]20conf2", "[", "s", "]"}], ",", 
         RowBox[{"s", ">", "sm20"}]}], "}"}]}], "}"}], "]"}], 
    FractionBox[
     RowBox[{" ", "180"}], "\[Pi]"]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.922769945793768*^9, {3.922791432076057*^9, 3.9227914363905487`*^9}, 
   3.923288361183856*^9, 4.001147132785692*^9},
 CellLabel->
  "In[128]:=",ExpressionUUID->"8c3bbd8b-1a02-436b-aadd-919cf184b15b"],

Cell[TextData[StyleBox["Now we define the elasticity",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147323331758*^9},ExpressionUUID->"a0874e5f-9942-4abb-9bdc-\
95b99d170cdf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]20", "[", "s_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"s", "<=", "sm\[Eta]20"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{"\[Epsilon]20", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox["sm\[Eta]20", "s"]}], ")"}], "1.5"]}]}], ",", 
        RowBox[{"s", ">", "sm\[Eta]20"}]}], "}"}]}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.922769994986944*^9, 3.922769997545595*^9}, {
