Cell[TextData[StyleBox["The phase-shift is given by",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147314854867*^9},ExpressionUUID->"842e57ef-10eb-47ac-97be-\
bcdd93bfa1c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]20conf1", "[", "s_", "]"}], "=", 
   RowBox[{"ArcCot", "[", 
    RowBox[{"cot\[Delta]20conf1", "[", "s", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]20conf2", "[", "s_", "]"}], "=", 
   RowBox[{"ArcCot", "[", 
    RowBox[{"cot\[Delta]20conf2", "[", "s", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.9227699083455753`*^9, {3.922791429648058*^9, 3.922791431477413*^9}},
