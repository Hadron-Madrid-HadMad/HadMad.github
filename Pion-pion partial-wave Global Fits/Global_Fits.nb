Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"v24", "[", "s_", "]"}], "=", 
   RowBox[{"w", "[", 
    RowBox[{
     RowBox[{"s", "+", " ", 
      RowBox[{"I", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "18"}]]}]}], ",", "s024"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vh24", "[", "s_", "]"}], "=", 
   RowBox[{"w", "[", 
    RowBox[{
     RowBox[{"s", "+", " ", 
      RowBox[{"I", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "18"}]]}]}], ",", "sh24"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.922791952900362*^9, 3.922791954011056*^9}},
 CellLabel->
  "In[265]:=",ExpressionUUID->"bda78c10-66dc-481b-bd53-ed7effd0e266"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cot\[Delta]24conf1", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["s", 
       RowBox[{"1", "/", "2"}]], " ", "s", " ", 
      SuperscriptBox["Mp", "8"]}], 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"kp", "[", "s", "]"}], "9"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", "*", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["Mp", "2"], "+", " ", 
           SuperscriptBox["\[CapitalDelta]24", "2"]}], ")"}]}], "-", "s"}], 
       ")"}]}]], 
    RowBox[{"(", 
     RowBox[{"B024", "+", 
      RowBox[{"B124", " ", 
       RowBox[{"v24", "[", "s", "]"}]}], "+", 
      RowBox[{"B224", " ", 
       SuperscriptBox[
        RowBox[{"v24", "[", "s", "]"}], "2"]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791954365037*^9, 3.922791955931446*^9}, {
   3.926507067180814*^9, 3.926507068026808*^9}, {3.926507155094638*^9, 
   3.926507163239039*^9}, {4.001151788763302*^9, 4.001151789609421*^9}, 
   4.001151834853953*^9},
 CellLabel->
  "In[267]:=",ExpressionUUID->"7b5bf43e-f1ab-45d0-a3e6-fc6cd499fc62"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Bh024", "=", 
   RowBox[{"B024", "+", 
    RowBox[{"B124", " ", 
     RowBox[{"v24", "[", "sm24", "]"}]}], "+", 
    RowBox[{"B224", " ", 
     SuperscriptBox[
      RowBox[{"v24", "[", "sm24", "]"}], "2"]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Bh124", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"B124", "+", 
      RowBox[{"2", " ", "B224", " ", 
       RowBox[{"v24", "[", "sm24", "]"}]}]}], ")"}], 
    FractionBox["s024", "sh24"], " ", 
    FractionBox[
     SqrtBox[
      RowBox[{"sh24", "-", "sm24"}]], 
     SqrtBox[
      RowBox[{"s024", "-", "sm24"}]]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SqrtBox["sm24"], "+", 
        SqrtBox[
         RowBox[{"sh24", "-", "sm24"}]]}], 
       RowBox[{
        SqrtBox["sm24"], "+", 
        SqrtBox[
         RowBox[{"s024", "-", "sm24"}]]}]], ")"}], "2"]}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.922791956103904*^9, 3.9227919622605467`*^9}, {
  3.9265071718159437`*^9, 3.926507199721027*^9}},
 CellLabel->
  "In[268]:=",ExpressionUUID->"59e11c88-0283-4907-ab69-03d2e3e58b7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cot\[Delta]24conf2", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["s", 
       RowBox[{"1", "/", "2"}]], " ", "s", " ", 
      SuperscriptBox["Mp", "8"]}], 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"kp", "[", "s", "]"}], "9"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", "*", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["Mp", "2"], "+", " ", 
           SuperscriptBox["\[CapitalDelta]24", "2"]}], ")"}]}], "-", "s"}], 
       ")"}]}]], 
    RowBox[{"(", 
     RowBox[{"Bh024", "+", 
      RowBox[{"Bh124", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"vh24", "[", "s", "]"}], "-", 
         RowBox[{"vh24", "[", "sm24", "]"}]}], ")"}]}], "+", 
      RowBox[{"Bh224", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"vh24", "[", "s", "]"}], "-", 
          RowBox[{"vh24", "[", "sm24", "]"}]}], ")"}], "2"]}], "+", 
      RowBox[{"Bh324", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"vh24", "[", "s", "]"}], "-", 
          RowBox[{"vh24", "[", "sm24", "]"}]}], ")"}], "3"]}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9227919625998583`*^9, 3.9227919652514687`*^9}, {
  3.926507070027327*^9, 3.926507071251143*^9}, {4.001151792499776*^9, 
