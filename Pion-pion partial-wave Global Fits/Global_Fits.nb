Cell["\<\
This is the final S0 Global Fit parametrization, and the corresponding \
phase-shift and elasticity functions\
\>", "Text",
 CellChangeTimes->{{4.0011328152899723`*^9, 4.0011328216574697`*^9}, {
  4.00113720320497*^9, 4.0011372043261843`*^9}},
 FontColor->RGBColor[
  1, 0, 0],ExpressionUUID->"e0e1a3b8-e363-49bf-909f-6e0fdce03e2e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]00", "[", "s_", "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]low00", "[", "s", "]"}], ",", 
        RowBox[{"s", "<=", "sm00"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]high00", "[", "s", "]"}], ",", 
        RowBox[{"s", ">", "sm00"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]00", "[", "s_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Eta]low00", "[", "s", "]"}], ",", 
        RowBox[{"s", "<=", "sm00"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Eta]high00", "[", "s", "]"}], ",", 
        RowBox[{"s", ">", "sm00"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"t00", "[", "s_", "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]00", "[", "s", "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"\[Delta]00", "[", "s", "]"}], " ", 
         RowBox[{"\[Pi]", "/", "90"}]}], "]"}]}], "-", "1"}], ")"}], 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"\[Sigma]pp", "[", "s", "]"}]}]]}], ";"}]}], "Input",
 CellChangeTimes->{3.9227688693900948`*^9, 3.9232882785603867`*^9, 
  4.001132864336055*^9},
 CellLabel->"In[63]:=",ExpressionUUID->"ada793b6-d114-41bf-9ca8-3060c913c82d"]
}, Closed]],

