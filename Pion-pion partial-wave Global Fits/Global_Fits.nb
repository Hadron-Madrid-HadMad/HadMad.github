 RowBox[{
  RowBox[{
   RowBox[{"t04", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]04", "[", "s", "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"\[Delta]04", "[", "s", "]"}], " ", 
         RowBox[{"\[Pi]", "/", "90"}]}], "]"}]}], "-", "1"}], ")"}], 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"\[Sigma]pp", "[", "s", "]"}]}]]}], ";"}]], "Input",
