c7f3fb32b4da"],

Cell[TextData[StyleBox["First, the Breit-Wigner amplitude, valid above 1.4 \
GeV",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 4.001150508839294*^9}, 
   4.0011512774436617`*^9},ExpressionUUID->"b109f3dc-3692-4a21-9510-\
fa43cddd8785"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"G0par", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalGamma]f4", "\[Rule]", "0.206"}], ",", 
     RowBox[{"mf4", "\[Rule]", "2.011"}], ",", 
     RowBox[{"Rf4", "\[Rule]", "4.671"}], ",", 
     RowBox[{"xf4", "\[Rule]", "0.16"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalDelta]G0par", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalDelta]\[CapitalGamma]f4", "\[Rule]", "0.080"}], ",", 
     RowBox[{"\[CapitalDelta]mf4", "\[Rule]", "0.023"}], ",", 
     RowBox[{"\[CapitalDelta]Rf4", "\[Rule]", "0"}], ",", 
     RowBox[{"\[CapitalDelta]xf4", "\[Rule]", "0.03"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.922791876624996*^9, 3.922791878438805*^9}, {
  3.922805554553146*^9, 3.9228056238333597`*^9}, {3.926504298672099*^9, 
  3.926504325992893*^9}, {4.001151115445957*^9, 4.0011511688553333`*^9}},
 CellLabel->
  "In[225]:=",ExpressionUUID->"6b46de19-d038-45ea-a967-18a1d941fe0c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"q04", "=", 
   RowBox[{"kp", "[", 
    SuperscriptBox["mf4", "2"], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]04", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s004", "=", 
   SuperscriptBox["1.75", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sm04", "=", 
   SuperscriptBox["1.4", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s\[Eta]04", "=", 
   SuperscriptBox["1.05", "2"]}], ";"}]}], "Input",
 CellChangeTimes->{{3.922791880052741*^9, 3.922791880823451*^9}},
 CellLabel->
  "In[227]:=",ExpressionUUID->"0dcb8fc5-51c7-4c31-abd8-7bef752ac026"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"w04", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{
     SqrtBox["s"], "-", 
     RowBox[{"\[Alpha]04", " ", 
      SqrtBox[
       RowBox[{"s004", "-", "s"}]]}]}], 
    RowBox[{
     SqrtBox["s"], "+", 
     RowBox[{"\[Alpha]04", " ", 
      SqrtBox[
       RowBox[{"s004", "-", "s"}]]}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v04", "[", "s_", "]"}], "=", 
   RowBox[{"w04", "[", 
    RowBox[{"s", "+", " ", 
     RowBox[{
      SuperscriptBox["10", 
       RowBox[{"-", "18"}]], " ", "I"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Blatt4", "[", "s_", "]"}], "=", 
   RowBox[{
    SuperscriptBox["s", "8"], "+", 
    RowBox[{"10", " ", 
     SuperscriptBox["s", "6"]}], "+", 
    RowBox[{"135", " ", 
     SuperscriptBox["s", "4"]}], "+", 
    RowBox[{"1575", " ", 
     SuperscriptBox["s", "2"]}], "+", "11025"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9227918809965267`*^9, 3.9227918819753*^9}},
 CellLabel->
  "In[232]:=",ExpressionUUID->"5c636c46-d48a-4634-8d2d-f2b4a74ac74f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]04", "[", "s_", "]"}], "=", 
   RowBox[{"\[CapitalGamma]f4", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"kp", "[", "s", "]"}], "q04"], ")"}], "9"], " ", 
    FractionBox[
     RowBox[{"Blatt4", "[", 
      RowBox[{"q04", " ", "Rf4"}], "]"}], 
     RowBox[{"Blatt4", "[", 
      RowBox[{
       RowBox[{"kp", "[", "s", "]"}], " ", "Rf4"}], "]"}]]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.922782878643344*^9, {3.922791882157126*^9, 3.922791882479699*^9}},
 CellLabel->
  "In[235]:=",ExpressionUUID->"61f3330a-2983-4820-8592-44682f1f3d24"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tbw04", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{"xf4", " ", "mf4", " ", 
     RowBox[{"\[CapitalGamma]04", "[", "s", "]"}]}], 
    RowBox[{
     RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["mf4", "2"], "-", "s", "-", 
       RowBox[{"I", " ", "mf4", " ", 
        RowBox[{"\[CapitalGamma]04", "[", "s", "]"}]}]}], ")"}]}]]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.922791882660118*^9, 3.922791882984356*^9}},
 CellLabel->
  "In[236]:=",ExpressionUUID->"8db61b9c-e170-4f87-ba10-e5566559f5c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Sbw04", "[", "s_", "]"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"2", " ", "I", " ", 
     RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
     RowBox[{"tbw04", "[", "s", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791883149336*^9, 3.92279188330717*^9}},
 CellLabel->
  "In[237]:=",ExpressionUUID->"eeb21b7b-8890-4fcb-8c8a-42b7e6995457"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]bw04", "[", "s_", "]"}], "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"ArcTan", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Sbw04", "[", "s", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"Sbw04", "[", "s", "]"}], "]"}]}], "]"}], " ", 
     FractionBox["90", "\[Pi]"]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791883471377*^9, 3.922791883832917*^9}},
 CellLabel->
  "In[238]:=",ExpressionUUID->"47cedad1-ad1f-41bf-877a-ba4cc9c6ac0f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]bw04", "[", "s_", "]"}], "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"Sbw04", "[", "s", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791884041976*^9, 3.922791884220579*^9}},
 CellLabel->
  "In[239]:=",ExpressionUUID->"e4dfd20b-9e64-44e1-962e-022ccc1d8059"],

Cell[TextData[StyleBox["Now, let\[CloseCurlyQuote]s define the low-energy \
conformal amplitude, matched to the B-W amplitude at 1.4 GeV",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 4.001150535608149*^9}, {
   4.001151309877159*^9, 
   4.001151310204949*^9}},ExpressionUUID->"ee4485c9-81b8-4972-9f0f-\
81567da5296f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fac04", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     SqrtBox["s"], 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"kp", "[", "s", "]"}], "9"]}]], 
    SuperscriptBox["Mp", "8"]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9227918844388933`*^9, {4.001151444220972*^9, 4.001151445987011*^9}},
 CellLabel->
  "In[240]:=",ExpressionUUID->"79a4f9d7-e7cc-445e-b621-1cba4b7c8781"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cotbweff04", "[", "s_", "]"}], "=", 
   FractionBox["1", 
    RowBox[{
     RowBox[{"Tan", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Delta]bw04", "[", "s", "]"}], " ", "\[Pi]"}], "180"], 
      "]"}], " ", 
     RowBox[{"fac04", "[", "s", "]"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791884641694*^9, 3.922791885016756*^9}},
 CellLabel->
  "In[241]:=",ExpressionUUID->"6ffa99a5-2fd4-423d-9781-57d39c15e76f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"derc04", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"cotbweff04", "[", 
      RowBox[{"sm04", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"cotbweff04", "[", 
      RowBox[{"sm04", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derv04", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"v04", "[", 
      RowBox[{"sm04", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"v04", "[", 
      RowBox[{"sm04", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.9227829083293543`*^9, {3.9227918851960373`*^9, 3.922791886800619*^9}},
 CellLabel->
  "In[242]:=",ExpressionUUID->"5cf95ce0-d300-4266-a494-d946f9ae44af"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"b104", "=", 
   FractionBox["derc04", "derv04"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b004", "=", 
   RowBox[{
    RowBox[{"cotbweff04", "[", "sm04", "]"}], "-", 
    RowBox[{"b104", " ", 
     RowBox[{"v04", "[", "sm04", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.922791886973516*^9, 3.922791893861247*^9}, {
  3.926504364964332*^9, 3.926504369042927*^9}},
 CellLabel->
  "In[244]:=",ExpressionUUID->"d02583fe-d178-47f0-8eeb-0f9d38c57432"],

Cell[TextData[StyleBox["The conformal phase-shift is defined as",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 4.001150535608149*^9}, {
   4.001150903799925*^9, 
   4.0011509107399073`*^9}},ExpressionUUID->"3f45c0c5-1b39-4955-9c1e-\
69d0dd018c64"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cot\[Delta]low04", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"b004", "+", 
      RowBox[{"b104", " ", 
       RowBox[{"v04", "[", "s", "]"}]}]}], 
     RowBox[{
      RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
      SuperscriptBox[
       RowBox[{"kp", "[", "s", "]"}], "8"]}]], 
    SuperscriptBox["Mp", "8"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227918940011787`*^9, 3.9227918951274776`*^9}, 
   3.926504345953848*^9, {4.001151454190699*^9, 4.001151457115788*^9}},
 CellLabel->
  "In[246]:=",ExpressionUUID->"c770da91-8435-4df4-929a-ee3e1818f0f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]low04", "[", "s_", "]"}], "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"ArcCot", "[", 
      RowBox[{"cot\[Delta]low04", "[", "s", "]"}], "]"}], " ", 
     FractionBox["180", "\[Pi]"]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227918953215723`*^9, 3.922791895500469*^9}},
 CellLabel->
  "In[247]:=",ExpressionUUID->"5a947759-283e-4343-a495-23a37aaacfe7"],

Cell[TextData[StyleBox["The phase-shift in the whole range is",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 4.001150535608149*^9}, 
   4.0011508491898327`*^9},ExpressionUUID->"762a21e1-0e77-40be-ae0a-\
7eea247dbdb7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]04", "[", "s_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]low04", "[", "s", "]"}], ",", 
        RowBox[{"s", "<=", "sm04"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]bw04", "[", "s", "]"}], ",", 
        RowBox[{"s", ">", "sm04"}]}], "}"}]}], "}"}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{
  3.922782945720886*^9, {3.9227918956896257`*^9, 3.922791896491455*^9}, 
   3.923288488576044*^9},
 CellLabel->
  "In[248]:=",ExpressionUUID->"dac05402-4c45-4807-b8f0-7e388c9fbbc4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]04", "=", 
   FractionBox[
    RowBox[{"1", "-", 
     RowBox[{"\[Eta]bw04", "[", "sm04", "]"}]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["s\[Eta]04", "sm04"]}], ")"}], 
     RowBox[{"9", "/", "2"}]]]}], ";"}]], "Input",
 CellChangeTimes->{
  3.922782951825667*^9, {3.9227918966948347`*^9, 3.9227918975194798`*^9}},
 CellLabel->
  "In[249]:=",ExpressionUUID->"af45859b-ec4e-458f-a990-b513b9db87f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"der\[Eta]04", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Eta]bw04", "[", 
      RowBox[{"sm04", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"\[Eta]bw04", "[", 
      RowBox[{"sm04", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227918977295856`*^9, 3.922791898517969*^9}},
 CellLabel->
  "In[250]:=",ExpressionUUID->"7a8aa782-59ca-4e2a-bed7-58a9e5c39e09"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r04", "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"sm04", " ", "der\[Eta]04"}], 
       RowBox[{"1", "-", 
        RowBox[{"\[Eta]bw04", "[", "sm04", "]"}]}]], "+", 
      FractionBox[
       RowBox[{"7", " ", "s\[Eta]04"}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"sm04", "-", "s\[Eta]04"}], ")"}]}]]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.922791898712469*^9, 3.9227919002272367`*^9}},
 CellLabel->
  "In[251]:=",ExpressionUUID->"a30a110f-422e-4109-8557-c11c66058993"],

Cell[TextData[StyleBox["The elasticity in the whole range is",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001147302400538*^9, {4.001150481718904*^9, 4.001150535608149*^9}, 
