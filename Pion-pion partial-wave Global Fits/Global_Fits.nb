Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cot\[Delta]22conf1", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["s", 
       RowBox[{"1", "/", "2"}]], " ", "s", " ", 
      SuperscriptBox["Mp", "4"]}], 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"kp", "[", "s", "]"}], "5"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", "*", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["Mp", "2"], "+", " ", 
           SuperscriptBox["\[CapitalDelta]22", "2"]}], ")"}]}], "-", "s"}], 
       ")"}]}]], 
    RowBox[{"(", 
     RowBox[{"B022", "+", 
      RowBox[{"B122", " ", 
       RowBox[{"v22", "[", "s", "]"}]}], "+", 
      RowBox[{"B222", " ", 
       SuperscriptBox[
        RowBox[{"v22", "[", "s", "]"}], "2"]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{
