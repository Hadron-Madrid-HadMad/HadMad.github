     RowBox[{"v20", "[", "sm20", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Bh120", "=", 
   RowBox[{"B120", 
    FractionBox["s020", "sh20"], " ", 
    FractionBox[
     SqrtBox[
      RowBox[{"sh20", "-", "sm20"}]], 
