Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"v02", "[", "s_", "]"}], "=", 
   RowBox[{"w", "[", 
    RowBox[{
     RowBox[{"s", "+", " ", 
      RowBox[{"I", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "18"}]]}]}], ",", "s002"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vh02", "[", "s_", "]"}], "=", 
