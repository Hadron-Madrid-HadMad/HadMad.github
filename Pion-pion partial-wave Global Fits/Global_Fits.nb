Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]02", "[", "s_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]low02", "[", "s", "]"}], ",", 
        RowBox[{"s", "<=", "sm202"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]high02", "[", "s", "]"}], ",", 
        RowBox[{"s", ">", "sm202"}]}], "}"}]}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.922782298056905*^9, 3.922782328913583*^9}, {
