c5864f1e29e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]02conf2", "[", "s_", "]"}], "=", 
   RowBox[{"ArcCot", "[", 
    RowBox[{"cot\[Delta]02conf2", "[", "s", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791688640009*^9, 3.922791689165702*^9}},
 CellLabel->
  "In[150]:=",ExpressionUUID->"b39051a5-c19e-42cf-808e-7f84d254599a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]low02", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Delta]02conf1", "[", "s", "]"}], ",", 
         RowBox[{"s", "<=", "sm02"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Delta]02conf2", "[", "s", "]"}], ",", 
         RowBox[{
          RowBox[{"sm02", "<", "s"}], "&&", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"\[Delta]02conf2", "[", "s", "]"}], "]"}], ">", "0"}]}]}],
         "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Delta]02conf2", "[", "s", "]"}], "+", "\[Pi]"}], ",", 
         RowBox[{
          RowBox[{"sm02", "<", "s"}], "&&", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"\[Delta]02conf2", "[", "s", "]"}], "]"}], "<", "0"}]}]}],
         "}"}]}], "}"}], "]"}], "*", 
    FractionBox["180", "\[Pi]"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227821104457283`*^9, 3.922782172774516*^9}, {
  3.922791693192993*^9, 3.922791695967411*^9}, {3.923288372776761*^9, 
  3.923288378015827*^9}, {4.001148015960578*^9, 4.001148069654413*^9}, {
  4.001148167848857*^9, 4.001148169506616*^9}, {4.00114820151729*^9, 
  4.00114821695588*^9}},
 CellLabel->
  "In[151]:=",ExpressionUUID->"2218a7e9-d904-4289-91a9-8558ccd6999e"],

Cell[TextData[StyleBox["Now we define the elasticity below 1.4 GeV",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001148448024536*^9, 
   4.00114848871751*^9},ExpressionUUID->"8df641ed-9fa3-4e5f-b0c8-\
522e9e6aef99"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]low02", "[", "s_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"s", "<=", "sm\[Eta]02"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{"\[Epsilon]02", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"1", "-", 
              FractionBox["sm\[Eta]02", "s"]}], 
             RowBox[{"1", "-", 
              FractionBox["sm\[Eta]02", 
               SuperscriptBox["Mf2", "2"]]}]], ")"}], 
           RowBox[{"5", "/", "2"}]], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"r02", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               FractionBox[
                RowBox[{"s", "-", "sm\[Eta]02"}], 
                RowBox[{
                 SuperscriptBox["Mf2", "2"], "-", "sm\[Eta]02"}]]}], 
              ")"}]}]}], ")"}]}]}], ",", 
        RowBox[{"s", ">", "sm\[Eta]02"}]}], "}"}]}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9227821776316032`*^9, 3.922782211991848*^9}, {
   3.922791696366243*^9, 3.922791698667387*^9}, 3.923288385824368*^9, {
   3.926502788345419*^9, 3.92650282050595*^9}},
 CellLabel->
  "In[152]:=",ExpressionUUID->"30c253fc-d835-462c-b361-9020fb21d8f2"],

Cell[TextData[StyleBox["The total amplitude below 1.4 GeV is given by",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.001148448024536*^9, 
   4.001148483431773*^9},ExpressionUUID->"9030a8ea-928d-43b6-8cb0-\
5da83ebbb257"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tlow02", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]low02", "[", "s", "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{"2", "\[ImaginaryI]", " ", 
         RowBox[{"\[Delta]low02", "[", "s", "]"}]}], "]"}]}], "-", "1"}], 
     ")"}], 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"\[Sigma]pp", "[", "s", "]"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{
  3.922782222025271*^9, {3.922791699020499*^9, 3.922791699666238*^9}},
 CellLabel->
  "In[153]:=",ExpressionUUID->"9eb52796-9b07-49cb-8f89-082f8242d866"]
}, Closed]],

