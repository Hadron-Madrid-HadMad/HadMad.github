11c111c465e8"],

Cell[TextData[StyleBox["We start with the phase-shift",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{
  4.0011327447337637`*^9},ExpressionUUID->"332fa8b3-ca03-46d6-b7d4-\
71d68e7a2735"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"vchev02", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"2", " ", 
     FractionBox[
      RowBox[{
       SuperscriptBox["s", 
        RowBox[{"1", "/", "2"}]], "-", 
       SuperscriptBox["sm202", 
        RowBox[{"1", "/", "2"}]]}], 
      RowBox[{"2", "-", 
       SuperscriptBox["sm202", 
        RowBox[{"1", "/", "2"}]]}]]}], "-", "1"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.922782272970633*^9, {3.9227917016172543`*^9, 3.9227917022292147`*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"075f531c-e359-4a16-b858-c6be1459cf59"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"der\[Delta]02", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Delta]low02", "[", 
      RowBox[{"sm202", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"\[Delta]low02", "[", 
      RowBox[{"sm202", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"der\[Eta]02", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Eta]low02", "[", 
      RowBox[{"sm202", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"\[Eta]low02", "[", 
      RowBox[{"sm202", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derv02", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"vchev02", "[", 
      RowBox[{"sm202", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
     RowBox[{"vchev02", "[", 
      RowBox[{"sm202", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.922791702567675*^9, 3.9227917071573772`*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"39c8f58c-c0a5-4ffa-a6f5-19100e07f986"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalDelta]02", "=", 
   RowBox[{
    FractionBox["der\[Delta]02", "derv02"], "+", 
    RowBox[{"4", " ", "d202"}], "-", 
    RowBox[{"9", " ", "d302"}], "+", 
    RowBox[{"16", " ", "d402"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791707517453*^9, 3.922791708882771*^9}, {
  4.001148580370019*^9, 4.0011485832167683`*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"5f583379-0521-41e3-90a9-b1699a5c3115"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]high02", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"\[Delta]low02", "[", "sm202", "]"}], "+", " ", 
    RowBox[{"\[CapitalDelta]02", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"chev1", "[", 
        RowBox[{"vchev02", "[", "s", "]"}], "]"}], "+", "1"}], ")"}]}], "+", 
    " ", 
    RowBox[{"d202", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"chev2", "[", 
        RowBox[{"vchev02", "[", "s", "]"}], "]"}], "-", "1"}], ")"}]}], "+", 
    RowBox[{"d302", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"chev3", "[", 
        RowBox[{"vchev02", "[", "s", "]"}], "]"}], "+", "1"}], ")"}]}], "+", 
    " ", 
    RowBox[{"d402", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"chev4", "[", 
        RowBox[{"vchev02", "[", "s", "]"}], "]"}], "-", "1"}], ")"}]}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.922791709348269*^9, 3.9227917133898687`*^9}, {
  4.0011485734420967`*^9, 4.001148577080027*^9}},
 CellLabel->
  "In[159]:=",ExpressionUUID->"1d839238-8ad1-45f5-ba13-53772a94fb9f"],

Cell[TextData[StyleBox["Finally, we define the elasticity above 1.4 GeV",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{
  4.0011327447337637`*^9, {4.001148643863985*^9, 
   4.0011486450432577`*^9}},ExpressionUUID->"c7602068-04fd-41f1-bda2-\
ab1bf80f2861"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qm02", "=", 
   RowBox[{"kp", "[", "sm202", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Q02", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox["s", "sm202"], "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Epsilon]002", "=", 
   SqrtBox[
    RowBox[{"-", 
     RowBox[{"Log", "[", 
      RowBox[{"\[Eta]low02", "[", "sm202", "]"}], "]"}]}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Epsilon]102", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"-", "sm202"}], " ", "der\[Eta]02", " "}], 
    RowBox[{"2", " ", "\[Epsilon]002", " ", 
     RowBox[{"\[Eta]low02", "[", "sm202", "]"}]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9227917154760933`*^9, 3.922791719509019*^9}, {
  3.926503154206846*^9, 3.9265031619110394`*^9}, {3.926575658415844*^9, 
  3.926575665775154*^9}},
 CellLabel->
  "In[160]:=",ExpressionUUID->"e888feef-0c05-44d2-b9fc-95e2a6b29a0f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]high02", "[", "s_", "]"}], "=", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[Epsilon]002", "+", 
        RowBox[{"\[Epsilon]102", " ", 
         RowBox[{"Q02", "[", "s", "]"}]}], "+", 
        RowBox[{"\[Epsilon]202", " ", 
         SuperscriptBox[
          RowBox[{"Q02", "[", "s", "]"}], "2"]}], "+", 
        RowBox[{"\[Epsilon]302", " ", 
         SuperscriptBox[
          RowBox[{"Q02", "[", "s", "]"}], "3"]}], "+", 
        RowBox[{"\[Epsilon]402", " ", 
         SuperscriptBox[
          RowBox[{"Q02", "[", "s", "]"}], "4"]}]}], " ", ")"}], "2"]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922791719825707*^9, 3.922791724271439*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"b29efc81-7aa1-4e98-b5a4-5045b32d0f4c"],

Cell[TextData[StyleBox["This is the final D0 Global Fit parametrization, and \
the corresponding phase-shift and elasticity functions",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{
  4.0011327447337637`*^9, {4.0011486329519*^9, 
