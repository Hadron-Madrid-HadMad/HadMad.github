   RowBox[{"vchev211", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"2", " ", 
     FractionBox[
      RowBox[{
       SuperscriptBox["s", 
        RowBox[{"1", "/", "2"}]], "-", 
       SuperscriptBox["sm211", 
        RowBox[{"1", "/", "2"}]]}], 
      RowBox[{"2", "-", 
       SuperscriptBox["sm211", 
        RowBox[{"1", "/", "2"}]]}]]}], "-", "1"}]}], ";"}]], "Input",
