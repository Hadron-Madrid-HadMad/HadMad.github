Cell[BoxData[{
 RowBox[{
  RowBox[{"s024", "=", 
   SuperscriptBox["1.65", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sh24", "=", 
   SuperscriptBox["2.4", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sm24", "=", 
   SuperscriptBox["0.85", "2"]}], ";"}]}], "Input",
 CellChangeTimes->{{3.922791952046381*^9, 3.922791952701131*^9}, 
