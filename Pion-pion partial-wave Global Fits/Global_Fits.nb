    "everything", " ", "is", " ", "rewritten", " ", "in", " ", "a", " ", 
     "different", " ", "way"}]}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{{3.922781032429014*^9, 3.922781038733577*^9}, {
  4.001137144037422*^9, 4.001137181081077*^9}},
 CellLabel->
