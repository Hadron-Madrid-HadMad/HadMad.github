Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalDelta]11", "=", 
   RowBox[{
    FractionBox["der\[Delta]11", "derv11"], "+", 
    RowBox[{"4", " ", "d211"}], "-", 
    RowBox[{"9", "d311"}], "+", 
    RowBox[{"16", " ", "d411"}], "-", 
    RowBox[{"25", "d511"}], "+", 
