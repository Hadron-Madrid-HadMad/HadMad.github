   3.92276621741072*^9}, {3.9227662802525787`*^9, 3.922766302329694*^9}, {
   3.922766349365033*^9, 3.922766353600281*^9}, {3.92276939545356*^9, 
   3.92276942031425*^9}, 3.92323158743743*^9, {3.923288242424909*^9, 
   3.923288266641356*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"2218c28c-3b88-4786-96a1-730808d7e913"],

