Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cot\[Delta]02conf1", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     SuperscriptBox["s", 
      RowBox[{"1", "/", "2"}]], 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"kp", "[", "s", "]"}], "5"]}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["Mf2", "2"], "-", "s"}], ")"}], 
    SuperscriptBox["Mp", "2"], 
    RowBox[{"(", 
     RowBox[{"B002", "+", 
      RowBox[{"B102", " ", 
       RowBox[{"v02", "[", "s", "]"}]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227916690852213`*^9, 3.9227916723652067`*^9}, 
   4.001147503392552*^9},
 CellLabel->
  "In[145]:=",ExpressionUUID->"308c8645-fe16-45dc-8827-4cdba22ea0be"],

