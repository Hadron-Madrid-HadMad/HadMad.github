Cell[BoxData[
 RowBox[{
  RowBox[{"der\[Eta]11", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Eta]low11", "[", 
      RowBox[{"sm211", "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], "-", 
