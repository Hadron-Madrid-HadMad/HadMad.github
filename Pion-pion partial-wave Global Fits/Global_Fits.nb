f7957d1980db"],

Cell[TextData[StyleBox["First, we define the conformal amplitude",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 
  4.001132617190175*^9}},ExpressionUUID->"9856f8fe-face-4acb-a490-\
8305f7e9ad1b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s011", "=", 
   SuperscriptBox["1.43", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]11", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sm11", "=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"Mp", "+", "M\[Omega]"}], ")"}], "2"]}], ";"}]}], "Input",
 CellChangeTimes->{3.922770134886161*^9, 4.001133331422185*^9},
 CellLabel->"In[74]:=",ExpressionUUID->"f26c2749-2069-469d-a168-bfcc493f72b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"w11", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{
     SqrtBox["s"], "-", 
     RowBox[{"\[Alpha]11", " ", 
      SqrtBox[
       RowBox[{"s011", "-", "s"}]]}]}], 
    RowBox[{
     SqrtBox["s"], "+", 
     RowBox[{"\[Alpha]11", " ", 
      SqrtBox[
       RowBox[{"s011", "-", "s"}]]}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v11", "[", "s_", "]"}], "=", 
   RowBox[{"w11", "[", 
    RowBox[{"s", "+", " ", 
     RowBox[{
      SuperscriptBox["10", 
       RowBox[{"-", "18"}]], " ", "I"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.922770142438499*^9, {3.922780702311599*^9, 3.92278070301553*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"66070fe4-1f35-4e53-8e83-58ae6ff969f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cot\[Delta]11conf", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{" ", 
      RowBox[{
       SuperscriptBox["m\[Rho]", "2"], "-", "s"}]}], 
     RowBox[{
      RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
      SuperscriptBox[
       RowBox[{"kp", "[", "s", "]"}], "2"]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["Mp", "3"]}], 
       RowBox[{
        SuperscriptBox["m\[Rho]", "2"], " ", 
        SuperscriptBox["s", 
         RowBox[{"1", "/", "2"}]]}]], "+", "B011", "+", 
      RowBox[{"B111", " ", 
       RowBox[{"v11", "[", "s", "]"}]}], "+", 
      RowBox[{"B211", " ", 
       SuperscriptBox[
        RowBox[{"v11", "[", "s", "]"}], "2"]}], "+", 
      RowBox[{"B311", " ", 
       SuperscriptBox[
        RowBox[{"v11", "[", "s", "]"}], "3"]}], "+", 
      RowBox[{"B411", " ", 
       SuperscriptBox[
        RowBox[{"v11", "[", "s", "]"}], "4"]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.922770148538005*^9, {4.001133333862714*^9, 4.001133335111079*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"d7a2b193-ea71-4989-aa52-e7a8548f7107"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t11conf", "[", "s_", "]"}], "=", 
   FractionBox["1", 
    RowBox[{
     RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"cot\[Delta]11conf", "[", "s", "]"}], "-", " ", "I"}], 
      ")"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{3.922770151553768*^9},
 CellLabel->"In[80]:=",ExpressionUUID->"54583e85-5423-4155-98d5-eac6a0c19168"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"S11conf", "[", "s_", "]"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"2", " ", "I", " ", 
     RowBox[{"\[Sigma]pp", "[", "s", "]"}], " ", 
     RowBox[{"t11conf", "[", "s", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.9227701575561447`*^9},
 CellLabel->"In[81]:=",ExpressionUUID->"d2346516-b767-46ba-9acd-356ebf6e1f0d"],

Cell[TextData[StyleBox["Now, we implement the inelastic amplitude",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132646343431*^9}, {
  4.0011368871921263`*^9, 
  4.0011368939199133`*^9}},ExpressionUUID->"64d2d388-2686-4720-8957-\
5a7065260a4e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]", "[", "s_", "]"}], "=", 
   SqrtBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"s", "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Mp", "+", "M\[Omega]"}], ")"}], "2"]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"s", "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Mp", "-", "M\[Omega]"}], ")"}], "2"]}], ")"}]}]]}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.9227701609218807`*^9, {4.001133343278552*^9, 4.001133345988826*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"b6837723-314b-40df-b839-1bab76bd6611"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]J", "=", 
   RowBox[{
    SuperscriptBox["Mp", "2"], "-", 
    SuperscriptBox["M\[Omega]", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]J", "=", 
   RowBox[{
    SuperscriptBox["Mp", "2"], "+", 
    SuperscriptBox["M\[Omega]", "2"]}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.92277016821764*^9, {4.001133347750382*^9, 4.001133349149377*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"4c17548a-079b-4751-a1ad-39391e24e89d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"J11", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["\[CapitalDelta]J", "s"], "-", 
         FractionBox["\[CapitalSigma]J", "\[CapitalDelta]J"]}], ")"}], " ", 
       RowBox[{"Log", "[", 
        FractionBox[
         SuperscriptBox["M\[Omega]", "2"], 
         SuperscriptBox["Mp", "2"]], "]"}]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Nu]", "[", "s", "]"}], "s"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{
            RowBox[{"\[Nu]", "[", "s", "]"}], "-", "s", "+", 
            "\[CapitalDelta]J"}], 
           RowBox[{
            RowBox[{"\[Nu]", "[", "s", "]"}], "+", "s", "+", 
            "\[CapitalDelta]J"}]], "]"}], "+", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{
            RowBox[{"\[Nu]", "[", "s", "]"}], "-", "s", "-", 
            "\[CapitalDelta]J"}], 
           RowBox[{
            RowBox[{"\[Nu]", "[", "s", "]"}], "+", "s", "-", 
            "\[CapitalDelta]J"}]], "]"}]}], ")"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "\[Pi]"}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.92277019346642*^9, 4.0011334471529512`*^9},
 CellLabel->"In[85]:=",ExpressionUUID->"9ba1ed8a-2f8e-490a-b7cc-3c85305983a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Mprom", "=", 
   RowBox[{"Mp", "+", "M\[Omega]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"k2\[Pi]\[Omega]", "[", "s_", "]"}], "=", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"\[Nu]", "[", "s", "]"}], "2"], 
    RowBox[{"4", " ", "s"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"R11", "[", "s_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{" ", "s", " "}], 
     SuperscriptBox["Mprom", "2"]], "-", "1"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.9227702029978724`*^9, {3.926501173575096*^9, 3.926501232727785*^9}, {
   3.926502929621481*^9, 3.92650292986136*^9}, 4.0011333581835823`*^9},
 CellLabel->"In[86]:=",ExpressionUUID->"11b72690-ec2d-4bf5-a2b7-cb6d30e59f68"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]11in", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"J11", "[", "s", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"K011", "+", 
      RowBox[{"K111", " ", 
       RowBox[{"R11", "[", "s", "]"}]}], "+", 
      RowBox[{"K211", " ", 
       SuperscriptBox[
        RowBox[{"R11", "[", "s", "]"}], "2"]}], "+", 
      RowBox[{"K311", " ", 
       SuperscriptBox[
        RowBox[{"R11", "[", "s", "]"}], "3"]}]}], ")"}], " ", 
    FractionBox[
     RowBox[{" ", 
      RowBox[{"k2\[Pi]\[Omega]", "[", "s", "]"}]}], 
     SuperscriptBox["Mprom", "2"]], 
    FractionBox[
     RowBox[{" ", 
      RowBox[{
       RowBox[{"kp", "[", "s", "]"}], "^", "3"}]}], 
     RowBox[{
      SuperscriptBox["Mp", "2"], " ", 
      SuperscriptBox["s", 
       RowBox[{"1", "/", "2"}]]}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922770206514489*^9, 3.9227702199142447`*^9}, {
   3.926501286850214*^9, 3.926501306723246*^9}, {3.926502933133916*^9, 
   3.926502936494158*^9}, 4.001133454028451*^9},
 CellLabel->"In[89]:=",ExpressionUUID->"a140633e-1740-474f-b4a3-c7f2cd575d52"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t11in", "[", "s_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"2", "\[ImaginaryI]", " ", 
       RowBox[{"\[Delta]11in", "[", "s", "]"}]}], "]"}], "-", "1"}], 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"\[Sigma]p", "[", "s", "]"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.922770223497913*^9, 3.922770229494718*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"aa6d975c-44fa-457d-9ff5-5cf6cc4e2218"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"S11in", "[", "s_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"\[Delta]11in", "[", "s", "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227702330976133`*^9, 3.9227702399218693`*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"fdb5748a-cdb8-4163-b064-089dcdc53b8e"],

Cell[TextData[StyleBox["Let\[CloseCurlyQuote]s define the total amplitude \
below 1.4 GeV",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{
  4.0011326746582527`*^9},ExpressionUUID->"64040ea5-c0ca-472a-b53d-\
8189cafe0149"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Slow11", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"S11conf", "[", "s", "]"}], " ", 
    RowBox[{"S11in", "[", "s", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.92277024835356*^9, 3.922770254865521*^9}, 
   3.9227707283923407`*^9},
 CellLabel->"In[92]:=",ExpressionUUID->"718e3923-9bae-4428-a80f-45db0c66ab60"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]low11", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"ArcTan", "[", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Slow11", "[", "s", "]"}], "]"}], ",", 
            RowBox[{"Im", "[", 
             RowBox[{"Slow11", "[", "s", "]"}], "]"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Im", "[", 
           RowBox[{"Slow11", "[", "s", "]"}], "]"}], ">=", "0"}]}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"ArcTan", "[", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Slow11", "[", "s", "]"}], "]"}], ",", 
             RowBox[{"Im", "[", 
              RowBox[{"Slow11", "[", "s", "]"}], "]"}]}], "]"}]}], "+", 
          "\[Pi]"}], ",", 
         RowBox[{
          RowBox[{"Im", "[", 
           RowBox[{"Slow11", "[", "s", "]"}], "]"}], "<", "0"}]}], "}"}]}], 
      "}"}], "]"}], " ", 
    FractionBox[
     RowBox[{" ", "180"}], "\[Pi]"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227707350976067`*^9, 3.9227707933381987`*^9}, {
  3.9227795022548027`*^9, 3.922779575864448*^9}, {3.923288314995201*^9, 
  3.923288316472227*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"e0dc4f75-f08d-4ec2-939e-be4df1818dcf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]low11", "[", "s_", "]"}], ":=", 
   RowBox[{"Abs", "[", 
    RowBox[{"Slow11", "[", "s", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.922779688745298*^9},
 CellLabel->"In[94]:=",ExpressionUUID->"cb01e3fb-3c15-4365-bf19-594f039265e0"]
}, Closed]],

