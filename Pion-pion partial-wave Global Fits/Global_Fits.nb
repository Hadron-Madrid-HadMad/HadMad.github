Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]24", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Delta]24conf1", "[", "s", "]"}], ",", 
         RowBox[{"s", "<=", "sm24"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Delta]24conf2", "[", "s", "]"}], ",", 
         RowBox[{"s", ">", "sm24"}]}], "}"}]}], "}"}], "]"}], "*", 
    FractionBox["180", "\[Pi]"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.922783107497697*^9, 3.92278315514909*^9}, {
   3.9227919660619783`*^9, 3.922791967066897*^9}, 3.923288523816257*^9, 
