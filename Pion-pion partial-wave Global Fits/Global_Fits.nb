Cell[TextData[StyleBox["This is the final S2 Global Fit parametrization",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{4.0011325586774673`*^9, 4.001132617190175*^9}, 
   4.0011473349543953`*^9},ExpressionUUID->"26261f85-3076-4c96-98d5-\
48e2191c8b29"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t20", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]20", "[", "s", "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{"2", "\[ImaginaryI]", " ", 
         RowBox[{"\[Delta]20", "[", "s", "]"}], " ", 
         RowBox[{"\[Pi]", "/", "180"}]}], "]"}]}], "-", "1"}], ")"}], 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"\[Sigma]pp", "[", "s", "]"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227914437034807`*^9, 3.922791446419298*^9}, {
