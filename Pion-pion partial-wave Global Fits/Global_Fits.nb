   4.001147314854867*^9},ExpressionUUID->"674bae4c-cfe7-4fde-9be7-\
ad173b1a6ca0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]24conf1", "[", "s_", "]"}], "=", 
   RowBox[{"ArcCot", "[", 
    RowBox[{"cot\[Delta]24conf1", "[", "s", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227919654221697`*^9, 3.9227919655888653`*^9}},
