Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]low00", "[", "s_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"ArcTan", "[", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Slow00", "[", "s", "]"}], "]"}], ",", 
           RowBox[{"Im", "[", 
            RowBox[{"Slow00", "[", "s", "]"}], "]"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Im", "[", 
           RowBox[{"Slow00", "[", "s", "]"}], "]"}], ">=", "0"}], "&&", 
         RowBox[{"s", "<=", 
          SuperscriptBox["0.9", "2"]}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"ArcTan", "[", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Slow00", "[", "s", "]"}], "]"}], ",", 
            RowBox[{"Im", "[", 
             RowBox[{"Slow00", "[", "s", "]"}], "]"}]}], "]"}]}], "+", 
         "\[Pi]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Im", "[", 
           RowBox[{"Slow00", "[", "s", "]"}], "]"}], "<", "0"}], "&&", 
         RowBox[{"s", "<=", 
          SuperscriptBox["1.2", "2"]}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"ArcTan", "[", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Slow00", "[", "s", "]"}], "]"}], ",", 
            RowBox[{"Im", "[", 
             RowBox[{"Slow00", "[", "s", "]"}], "]"}]}], "]"}]}], "+", 
         "\[Pi]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Im", "[", 
           RowBox[{"Slow00", "[", "s", "]"}], "]"}], ">=", "0"}], "&&", 
         RowBox[{"s", ">", 
          SuperscriptBox["0.9", "2"]}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"ArcTan", "[", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Slow00", "[", "s", "]"}], "]"}], ",", 
            RowBox[{"Im", "[", 
             RowBox[{"Slow00", "[", "s", "]"}], "]"}]}], "]"}]}], "+", 
         RowBox[{"2", "\[Pi]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Im", "[", 
           RowBox[{"Slow00", "[", "s", "]"}], "]"}], "<", "0"}], "&&", 
         RowBox[{"s", ">", 
          SuperscriptBox["1.2", "2"]}]}]}], "}"}]}], "}"}], "]"}], 
   RowBox[{"180", "/", "\[Pi]"}]}]}]], "Input",
 CellChangeTimes->{{3.922764332347611*^9, 3.922764495690084*^9}, {
   3.922764608107751*^9, 3.9227646099537*^9}, {3.92276466769134*^9, 
