Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]02", "[", "s_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Eta]low02", "[", "s", "]"}], ",", 
        RowBox[{"s", "<=", "sm202"}]}], "}"}], ",", 
      RowBox[{"{", 
