Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]24conf2", "[", "s_", "]"}], "=", 
   RowBox[{"ArcCot", "[", 
    RowBox[{"cot\[Delta]24conf2", "[", "s", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9227919657379208`*^9, 3.9227919659101143`*^9}},
 CellLabel->
